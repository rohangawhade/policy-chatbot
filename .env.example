# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme
APP_UPLOAD_DIR=./uploads
APP_MAX_UPLOAD_SIZE_MB=25

# --- Database (SQLAlchemy async + Alembic) ---
DATABASE_URL=postgresql+asyncpg://policypal:policypal@localhost:5432/policypal
DATABASE_POOL_SIZE=10

# --- Redis (cache + Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Cache ---
CACHE_TTL_SECONDS=3600

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=policypal

# --- LLM / LiteLLM — model tiers are config-driven ---
# If LLM_POWERFUL_MODEL is empty or its provider key is missing, all queries
# fall back to LLM_CHEAP_MODEL automatically. No code changes needed.
LLM_CHEAP_MODEL=claude-haiku-4-5-20251001
LLM_POWERFUL_MODEL=claude-sonnet-4-6
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_COMPLEXITY_THRESHOLD=0.4
LLM_FALLBACK_ENABLED=true
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_STREAMING_ENABLED=true
LLM_DAILY_COST_ALERT_THRESHOLD_USD=50.0

# Provider keys used by LiteLLM, depending on which models you configure above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Retry policy (exponential backoff with jitter, external calls) ---
RETRY_LLM_GENERATION_MAX_ATTEMPTS=3
RETRY_LLM_EMBEDDING_MAX_ATTEMPTS=2
RETRY_PINECONE_MAX_ATTEMPTS=3
RETRY_REDIS_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=10.0

# --- Rate limiting (Redis-backed sliding window, LLM-calling endpoints) ---
RATE_LIMIT_CHAT_MAX_REQUESTS=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# --- Auth (OAuth2 + JWT) ---
AUTH_JWT_SECRET_KEY=changeme
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite exposes only VITE_-prefixed vars to the client) ---
VITE_API_BASE_URL=http://localhost:8000
